generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
  NEEDS_CHANGES
}

model User {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  password        String
  role            Role            @default(USER)
  skills          String[]        @default([])
  education       String?
  resumeUrl       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdInternships Internship[] @relation("AdminInternships")
  applications    Application[]
  assignedTasks   Task[]          @relation("AssignedTasks")
  submissions     Submission[]
  feedbackReceived Feedback[]     @relation("FeedbackToUser")
  feedbackGiven   Feedback[]      @relation("FeedbackByAdmin")
  notifications   Notification[]
  bookmarks       Bookmark[]
  activityLogs    ActivityLog[]
}

model Internship {
  id          String        @id @default(cuid())
  title       String
  description String
  skills      String[]
  duration    String
  stipend     Int
  deadline    DateTime
  adminId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  admin       User          @relation("AdminInternships", fields: [adminId], references: [id])
  applications Application[]
  bookmarks   Bookmark[]
}

model Application {
  id           String             @id @default(cuid())
  userId       String
  internshipId String
  status       ApplicationStatus  @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation(fields: [userId], references: [id])
  internship   Internship         @relation(fields: [internshipId], references: [id])

  @@unique([userId, internshipId])
}

model Task {
  id          String        @id @default(cuid())
  title       String
  description String
  deadline    DateTime
  priority    TaskPriority  @default(MEDIUM)
  status      TaskStatus    @default(TODO)
  resourceUrl String?
  assignedTo  String
  assignedBy  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  assignee    User          @relation("AssignedTasks", fields: [assignedTo], references: [id])
  submissions Submission[]
}

model Submission {
  id        String           @id @default(cuid())
  taskId    String
  userId    String
  content   String?
  fileUrl   String?
  githubUrl String?
  status    SubmissionStatus @default(SUBMITTED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  task      Task             @relation(fields: [taskId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
}

model Feedback {
  id          String   @id @default(cuid())
  userId      String
  adminId     String
  rating      Int
  comment     String
  metricsJson Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation("FeedbackToUser", fields: [userId], references: [id])
  admin       User     @relation("FeedbackByAdmin", fields: [adminId], references: [id])
  history     FeedbackHistory[]
}

model FeedbackHistory {
  id         String   @id @default(cuid())
  feedbackId String
  rating     Int
  comment    String
  metricsJson Json?
  changedAt  DateTime @default(now())
  feedback   Feedback @relation(fields: [feedbackId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Bookmark {
  id           String     @id @default(cuid())
  userId       String
  internshipId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id])
  internship   Internship @relation(fields: [internshipId], references: [id])

  @@unique([userId, internshipId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  meta      Json?
  createdAt DateTime @default(now())
  admin     User     @relation(fields: [adminId], references: [id])
}
